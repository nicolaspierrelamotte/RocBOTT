+    elif tool == "Grep":
+        verifie_perimetre(str(ti.get("path") or "") or cwd, cwd, racine, motifs, role)
+        g = ti.get("glob")
+        if g:
+            verifie_glob_param(str(g), motifs, role)
+        t = ti.get("type")
+        if t and not re.fullmatch(r"[A-Za-z0-9_+-]+", str(t)):
+            raise Refus(f"Mur {role} : paramètre type « {t} » inattendu.")
+    elif tool == "Glob":
