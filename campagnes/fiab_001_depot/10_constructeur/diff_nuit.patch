+RE_CITATIONS = re.compile(r'''"(?:[^"\\]|\\.)*"|'[^']*\'''', re.S)
+RE_HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n(.*?)\n[ \t]*\2[ \t]*(?:\n|$)", re.S)
+RE_CHEMIN_DANS_CODE = re.compile(r"[\w.~\-]*(?:/[\w.~\-]+)+")
+VERBES_ECRITURE = re.compile(
