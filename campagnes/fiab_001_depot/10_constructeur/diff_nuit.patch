+def decoupe(cmd: str) -> list:
+    """Coupe aux séparateurs de commandes (; && || | & retour-ligne) HORS des chaînes citées."""
+    morceaux, cur, quote, i = [], [], "", 0
+    while i < len(cmd):
+        ch = cmd[i]
+        if quote:
+            cur.append(ch)
+            if ch == "\\" and quote == '"' and i + 1 < len(cmd):
+                cur.append(cmd[i + 1])
+                i += 1
+            elif ch == quote:
+                quote = ""
+        elif ch in "\"'":
+            quote = ch
+            cur.append(ch)
+        else:
+            m = RE_SEP.match(cmd, i)
+            if m and m.end() > i:
+                morceaux.append("".join(cur))
+                cur = []
+                i = m.end()
+                continue
+            cur.append(ch)
+        i += 1
+    morceaux.append("".join(cur))
+    return morceaux
+
+
