+    tdn = {k: v for k, v in TDN.items() if k != champ}
+    ecrire_json(d / "30_juge/temoin_derive_nulle.json", {**tdn, "t": 0.1})
+    assert a(fermees(repo, d), "P3 : champs manquants")
