+    (d / "30_juge/temoin_derive_nulle.json").unlink()
+    assert a(fermees(repo, d), "P3")
+    (d / "30_juge/temoin_derive_nulle.json").write_text("[1, 2]")
+    assert a(fermees(repo, d), "P3")
